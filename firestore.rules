rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuth() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    match /clusters/{clusterId} {
      allow read: if true;
      allow write: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /regions/{regionId} {
      allow read: if isAdmin() ||
                  !('clusterId' in resource.data) || 
                  resource.data.clusterId == 'cluster_elementary' ||
                  (isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clusterAccess[resource.data.clusterId] == 'active');
      allow write: if isAdmin();
    }
    
    match /chapters/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /units/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Quizzes: Authenticated Read, Admin Write
    match /quizzes/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Questions: Authenticated users can list/read public questions
    match /questions/{questionId} {
      allow create: if isAuth();
      allow read: if isAuth();
      allow update, delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Answers: Authenticated users can read
    match /answers/{answerId} {
      allow create: if isAuth();
      allow read: if isAuth();
      allow update, delete: if isAuth() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Users: Any authenticated user can read user profiles (for ranking). Writing is restricted.
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && (request.auth.uid == userId || isAdmin());
      
      // Allow subcollections (like 'history', 'crystal_transactions')
      match /{document=**} {
        allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Notifications: Users can read/write their own notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuth();
    }

    // Star Messages (Community Ticker)
    match /starMessages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
    }
  }
}

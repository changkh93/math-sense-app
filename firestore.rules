rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuth() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    function isLinkedParentOf(userId) {
      return isAuth() &&
             exists(/databases/$(database)/documents/parents/$(request.auth.uid)) &&
             userId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.childrenUids;
    }

    function streakManagedKeys() {
      return [
        'currentStreak',
        'lastStreakDate',
        'streakFreezeCount',
        'longestStreak',
        'streakMilestones',
        'streakWriteAudit'
      ];
    }

    function touchesManagedStreakFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(streakManagedKeys());
    }

    function hasValidStreakWriteAudit() {
      return request.resource.data.streakWriteAudit is map &&
             request.resource.data.streakWriteAudit.version == 2 &&
             request.resource.data.streakWriteAudit.source is string &&
             request.resource.data.streakWriteAudit.writerUid is string &&
             request.resource.data.streakWriteAudit.writerUid == request.auth.uid &&
             request.resource.data.streakWriteAudit.writtenAt == request.time;
    }

    function assignmentStudentWritableKeys() {
      return [
        'userId',
        'userName',
        'clusterId',
        'regionId',
        'date',
        'content',
        'links',
        'attachments',
        'notebookData',
        'status',
        'revisionCount',
        'isOfflineChecked',
        'submittedAt',
        'feedbackResponse',
        'feedbackReaction',
        'feedbackComment',
        'feedbackRespondedAt',
        'updatedAt'
      ];
    }

    function assignmentFeedbackResponseKeys() {
      return [
        'feedbackResponse',
        'feedbackReaction',
        'feedbackComment',
        'feedbackRespondedAt',
        'updatedAt'
      ];
    }

    match /clusters/{clusterId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAuth() && (
        isAdmin() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount'])
      );
    }

    match /regions/{regionId} {
      allow read: if true; // Regions metadata must be readable so clients can check `isPrivate` and `accessCode` (or handle this via restricted fields if needed, but for now we need titles & codes).
      allow write: if isAdmin();
      
      // Allow students to add themselves when they verify the code
      match /students/{studentId} {
        allow read: if isAdmin() || request.auth.uid == studentId;
        allow write: if isAdmin() || request.auth.uid == studentId;
      }
    }
    
    match /chapters/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /units/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Quizzes: Authenticated Read, Admin Write
    match /quizzes/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Anonymous aggregate quiz stats. Writes are server-managed by Cloud Functions
    // so a student cannot inflate answer/reaction counts.
    match /quizQuestionStats/{statId} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /quizQuestionResponses/{responseId} {
      allow read, write: if false;
    }

    // Questions: Authenticated users can list/read public questions
    match /questions/{questionId} {
      allow create: if isAuth();
      allow read: if isAuth();
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answerCount', 'updatedAt'])
      );
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Answers: Authenticated users can read
    match /answers/{answerId} {
      allow create: if isAuth();
      allow read: if isAuth();
      allow update: if isAuth() && (
        request.auth.uid == resource.data.userId || 
        isAdmin() || 
        request.auth.uid == get(/databases/$(database)/documents/questions/$(resource.data.questionId)).data.userId
      );
      allow delete: if isAuth() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Study Crews: created by students, activated by admins, then used for Study Stream rooms.
    match /crews/{crewId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        request.resource.data.leaderId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        isAdmin() ||
        (
          resource.data.leaderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'motto', 'description', 'color', 'groupId', 'groupName', 'clusterId', 'clusterName',
            'scheduleDays', 'scheduleTimes', 'updatedAt'
          ])
        ) ||
        (
          request.auth.uid in request.resource.data.memberIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();

      match /greetings/{greetingId} {
        allow read: if isAuth();
        allow create: if isAuth() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.crewId == crewId;
        allow update, delete: if isAuth() && (
          isAdmin() || resource.data.userId == request.auth.uid
        );
      }
    }

    match /studyRooms/{roomId} {
      allow read: if isAuth();
      allow create, delete: if false;
      allow update: if isAuth() && (
        (
          resource.data.hostUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'chatEnabled', 'micsEnabled', 'lastActivityAt'
          ])
        ) ||
        isAdmin()
      );

      match /participants/{participantId} {
        allow read: if isAuth();
        allow create: if isAuth() &&
          request.auth.uid == participantId &&
          request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.participantIds &&
          request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'role', 'peerId', 'cameraOn', 'micOn', 'focusStatus', 'joinedAt', 'lastSeenAt', 'deviceLabel', 'chatMessage', 'chatUpdatedAt'
          ]);
        allow update: if isAuth() &&
          request.auth.uid == participantId &&
          request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.participantIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'uid', 'displayName', 'role', 'peerId', 'cameraOn', 'micOn', 'focusStatus', 'joinedAt', 'lastSeenAt', 'deviceLabel', 'chatMessage', 'chatUpdatedAt'
          ]);
        allow delete: if isAuth() && (request.auth.uid == participantId || isAdmin());
      }
    }

    // Users: Any authenticated user can read user profiles (for ranking). Writing is restricted.
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuth() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          (!touchesManagedStreakFields() || hasValidStreakWriteAudit())
        )
      );
      allow delete: if isAdmin();
      
      // Allow subcollections (like 'history', 'crystal_transactions', 'learning_progress', 'activityLogs')
      match /{document=**} {
        allow create: if isAuth() && (
          request.auth.uid == userId ||
          isAdmin()
        );
        allow read: if isAuth() && (
          request.auth.uid == userId || 
          isAdmin() ||
          isLinkedParentOf(userId)
        );
        allow update, delete: if isAuth() && (
          request.auth.uid == userId ||
          isAdmin()
        );
      }
    }

    // Server-managed crystal gifting audit and daily limit documents.
    match /crystalTransfers/{transferId} {
      allow read: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    match /crystalTransferDailyLimits/{limitId} {
      allow read: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // Parents: Parent accounts can read their own doc, admins can manage
    match /parents/{parentId} {
      allow read: if isAuth() && (request.auth.uid == parentId || isAdmin());
      allow write: if isAdmin();
    }

    // Public applications are written by Cloud Functions and managed by admins.
    match /applications/{applicationId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Notifications: Users can read/write their own notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuth();
    }

    // Direct Memos: one-to-one letter style messages. Creation and scheduled delivery
    // are handled by Cloud Functions so the 24-hour per-recipient limit cannot be bypassed.
    match /directMemos/{memoId} {
      allow read: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create, delete: if false;
      allow update: if isAuth() && (
        (
          resource.data.recipientId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRead', 'readAt', 'recipientArchivedAt', 'recipientDeletedAt', 'updatedAt'
          ])
        ) ||
        (
          resource.data.senderId == request.auth.uid &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'senderArchivedAt', 'senderDeletedAt', 'updatedAt'
            ]) ||
            (
              resource.data.isRead == false &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'senderArchivedAt', 'senderDeletedAt', 'recipientDeletedAt', 'updatedAt'
              ])
            )
          )
        )
      );
    }

    // Assignments (Stellar Archive)
    match /assignments/{assignmentId} {
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.keys().hasOnly(assignmentStudentWritableKeys());
      allow read: if isAuth();
      allow update: if isAuth() && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.status == 'submitted' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(assignmentStudentWritableKeys())
        ) ||
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(assignmentFeedbackResponseKeys()) &&
          request.resource.data.feedbackReaction in ['thumbs_up', 'thumbs_down'] &&
          request.resource.data.feedbackComment is string &&
          request.resource.data.feedbackComment.size() <= 1000 &&
          request.resource.data.feedbackResponse is map &&
          request.resource.data.feedbackResponse.reaction == request.resource.data.feedbackReaction &&
          request.resource.data.feedbackResponse.comment == request.resource.data.feedbackComment
        )
      );
      allow delete: if isAdmin();
    }

    // Assignment warning ledger. Admins issue/cancel warnings, students can only
    // submit one immutable appeal for their own active warning.
    match /assignmentWarnings/{warningId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isLinkedParentOf(resource.data.userId)
      );
      allow create: if isAdmin() || (
        isAuth() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type == 'consecutive_missing_assignment' &&
        request.resource.data.status == 'active'
      );
      allow update: if isAdmin() || (
        isAuth() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'active' &&
        (!('appealLocked' in resource.data) || resource.data.appealLocked != true) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'appeal', 'appealLocked', 'updatedAt']) &&
        request.resource.data.status == 'appealed' &&
        request.resource.data.appealLocked == true &&
        request.resource.data.appeal is map &&
        request.resource.data.appeal.status == 'submitted' &&
        request.resource.data.appeal.text is string &&
        request.resource.data.appeal.text.size() >= 10 &&
        request.resource.data.appeal.text.size() <= 2000 &&
        request.resource.data.appeal.submittedAt == request.time
      );
      allow delete: if isAdmin();
    }

    // Star Messages (Community Ticker)
    match /starMessages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
    }

    // Attendance (Warp Gate Docking)
    match /attendance/{attendanceId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Collection Group: history (for Region/Chapter leaderboards)
    // Allows authenticated users to query quiz history across all users
    // for scope-specific ranking (e.g. all scores within a Region or Chapter).
    // History docs only contain quiz metadata: unitId, regionId, chapterId, score.
    match /{path=**}/history/{historyId} {
      allow read: if isAuth();
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuth() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Member/parent/guest authentication. Anonymous guests (crew guests) also
    // pass this check; they are additionally gated by isAdmin() for admin paths
    // and by per-crew guest access flags for crew data.
    function isAuth() {
      return request.auth != null;
    }

    function isAgoraBanned(userId) {
      return exists(/databases/$(database)/documents/agoraBannedUsers/$(userId));
    }

    function isLinkedParentOf(userId) {
      return isAuth() &&
             exists(/databases/$(database)/documents/parents/$(request.auth.uid)) &&
             userId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.childrenUids;
    }

    function streakManagedKeys() {
      return [
        'currentStreak',
        'lastStreakDate',
        'streakFreezeCount',
        'longestStreak',
        'streakMilestones',
        'streakWriteAudit'
      ];
    }

    function touchesManagedStreakFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(streakManagedKeys());
    }

    function hasValidStreakWriteAudit() {
      return request.resource.data.streakWriteAudit is map &&
             request.resource.data.streakWriteAudit.version == 2 &&
             request.resource.data.streakWriteAudit.source is string &&
             request.resource.data.streakWriteAudit.writerUid is string &&
             request.resource.data.streakWriteAudit.writerUid == request.auth.uid &&
             request.resource.data.streakWriteAudit.writtenAt == request.time;
    }

    function assignmentStudentWritableKeys() {
      return [
        'userId',
        'userName',
        'clusterId',
        'regionId',
        'date',
        'content',
        'links',
        'attachments',
        'notebookData',
        'status',
        'revisionCount',
        'isOfflineChecked',
        'submittedAt',
        'feedbackResponse',
        'feedbackReaction',
        'feedbackComment',
        'feedbackRespondedAt',
        'updatedAt'
      ];
    }

    function assignmentFeedbackResponseKeys() {
      return [
        'feedbackResponse',
        'feedbackReaction',
        'feedbackComment',
        'feedbackRespondedAt',
        'updatedAt'
      ];
    }

    match /clusters/{clusterId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAuth() && (
        isAdmin() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount'])
      );
    }

    match /regions/{regionId} {
      allow read: if true; // Regions metadata must be readable so clients can check `isPrivate` and `accessCode` (or handle this via restricted fields if needed, but for now we need titles & codes).
      allow write: if isAdmin();
      
      // Allow students to add themselves when they verify the code
      match /students/{studentId} {
        allow read: if isAdmin() || request.auth.uid == studentId;
        allow write: if isAdmin() || request.auth.uid == studentId;
      }
    }
    
    match /chapters/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /units/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Quizzes: Authenticated Read, Admin Write
    match /quizzes/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Code trace exercises: students read, admins import/edit.
    match /codeExercises/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Anonymous aggregate quiz stats. Writes are server-managed by Cloud Functions
    // so a student cannot inflate answer/reaction counts.
    match /quizQuestionStats/{statId} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /quizQuestionResponses/{responseId} {
      allow read: if isAuth() && responseId.matches('^' + request.auth.uid + '_.*');
      allow write: if false;
    }

    // Questions: Authenticated users can list/read public questions
    match /questions/{questionId} {
      allow create: if isAuth() && !isAgoraBanned(request.auth.uid);
      allow read: if isAuth();
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answerCount', 'updatedAt'])
      );
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Answers: Authenticated users can read
    match /answers/{answerId} {
      allow create: if isAuth();
      allow read: if isAuth();
      allow update: if isAuth() && (
        request.auth.uid == resource.data.userId || 
        isAdmin() || 
        request.auth.uid == get(/databases/$(database)/documents/questions/$(resource.data.questionId)).data.userId
      );
      allow delete: if isAuth() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Agora write bans: admins manage the ban list; students can read only their own ban
    // so the client can show a clear message before attempting to post.
    match /agoraBannedUsers/{userId} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    // Study Crews: created by students, activated by admins, then used for Study Stream rooms.
    match /crews/{crewId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        request.resource.data.leaderId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAuth() && (
        isAdmin() ||
        (
          resource.data.leaderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'motto', 'description', 'color', 'groupId', 'groupName', 'clusterId', 'clusterName',
            'scheduleDays', 'scheduleTimes', 'updatedAt'
          ])
        ) ||
        (
          request.auth.uid in request.resource.data.memberIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();

      match /greetings/{greetingId} {
        allow read: if isAuth();
        allow create: if isAuth() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.crewId == crewId;
        allow update, delete: if isAuth() && (
          isAdmin() || resource.data.userId == request.auth.uid
        );
      }

      match /guestSessions/{guestId} {
        allow read: if isAuth();
        allow write: if false;
      }
    }

    match /studyRooms/{roomId} {
      allow read: if isAuth();
      allow create, delete: if false;
      allow update: if isAuth() && (
        (
          resource.data.hostUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'chatEnabled', 'micsEnabled', 'lastActivityAt'
          ])
        ) ||
        isAdmin()
      );

      match /participants/{participantId} {
        allow read: if isAuth();
        allow create: if isAuth() &&
          request.auth.uid == participantId &&
          request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.participantIds &&
          request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'role', 'peerId', 'cameraOn', 'micOn', 'focusStatus', 'joinedAt', 'lastSeenAt', 'deviceLabel', 'chatMessage', 'chatUpdatedAt'
          ]);
        allow update: if isAuth() &&
          request.auth.uid == participantId &&
          request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.participantIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'uid', 'displayName', 'role', 'peerId', 'cameraOn', 'micOn', 'focusStatus', 'joinedAt', 'lastSeenAt', 'deviceLabel', 'chatMessage', 'chatUpdatedAt'
          ]);
        allow delete: if isAuth() && (request.auth.uid == participantId || isAdmin());
      }
    }

    match /openStudyPools/{poolId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Quiz Battle MVP: all writes are server-managed by Cloud Functions.
    match /quizBattleQueueTickets/{ticketId} {
      allow read: if isAuth() && (
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    match /quizBattles/{battleId} {
      allow read: if isAuth() && (
        request.auth.uid in resource.data.participantUids ||
        isAdmin()
      );
      allow write: if false;

      match /answers/{answerId} {
        allow read: if isAuth() && (
          answerId.matches('^' + request.auth.uid + '_.*') ||
          isAdmin()
        );
        allow write: if false;
      }
    }

    // AI 대전의 내부 진행 상태는 서버만 읽고 쓴다.
    match /quizBattleAISecrets/{battleId} {
      allow read, write: if false;
    }

    match /studyCrewMissionPlans/{dateKey} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /studyCrewDailyMissions/{scopeKey} {
      allow read: if isAuth();
      allow write: if false;

      match /days/{dayId} {
        allow read: if isAuth();
        allow write: if false;

        match /responses/{responseId} {
          allow read: if isAuth();
          allow write: if false;
        }
      }
    }

    // Users: Any authenticated user can read user profiles (for ranking). Writing is restricted.
    match /liveStatuses/{userId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuth() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          (!touchesManagedStreakFields() || hasValidStreakWriteAudit())
        )
      );
      allow delete: if isAdmin();
      
      // Allow subcollections (like 'history', 'crystal_transactions', 'learning_progress', 'activityLogs')
      match /{document=**} {
        allow create: if isAuth() && (
          request.auth.uid == userId ||
          isAdmin()
        );
        allow read: if isAuth() && (
          request.auth.uid == userId || 
          isAdmin() ||
          isLinkedParentOf(userId)
        );
        allow update, delete: if isAuth() && (
          request.auth.uid == userId ||
          isAdmin()
        );
      }
    }

    // Server-managed crystal gifting audit and daily limit documents.
    match /crystalTransfers/{transferId} {
      allow read: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    match /crystalTransferDailyLimits/{limitId} {
      allow read: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // Parents: Parent accounts can read their own doc, admins can manage
    match /parents/{parentId} {
      allow read: if isAuth() && (request.auth.uid == parentId || isAdmin());
      allow write: if isAdmin();
    }

    // Referral and tuition data is calculated by trusted Cloud Functions.
    // Clients may read only their own family/student records; every mutation is
    // routed through a callable function so validation and audit logs cannot be
    // bypassed.
    match /familyBillingAccounts/{parentId} {
      allow read: if isAuth() && (request.auth.uid == parentId || isAdmin());
      allow write: if false;
    }

    match /studentEnrollments/{studentId} {
      allow read: if isAuth() && (
        request.auth.uid == studentId ||
        isLinkedParentOf(studentId) ||
        isAdmin()
      );
      allow write: if false;
    }

    match /referralInvites/{inviteId} {
      allow read, write: if false;
    }

    match /referrals/{referralId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /familyBillingStatements/{statementId} {
      allow read: if isAuth() && (
        resource.data.parentUid == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Public applications are written by Cloud Functions and managed by admins.
    match /applications/{applicationId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // 방학특강 신청서 — Cloud Functions가 쓰고 관리자가 관리.
    match /vacationCampApplications/{applicationId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Monthly evaluation certificate awards. Admins grant awards; students can
    // read their own award ledger for the dashboard certificate board.
    match /monthlyEvaluationAwards/{awardId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        isLinkedParentOf(resource.data.studentId)
      );
      allow create, update, delete: if isAdmin();
    }

    // Monthly scholarship awards. Admins grant awards; students and linked
    // parents can read awarded scholarship certificates.
    match /scholarshipAwards/{awardId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        isLinkedParentOf(resource.data.studentId)
      );
      allow create, update, delete: if isAdmin();
    }

    // Notifications: Users can read/write their own notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuth();
    }

    // Direct Memos: one-to-one letter style messages. Creation and scheduled delivery
    // are handled by Cloud Functions so the 24-hour per-recipient limit cannot be bypassed.
    match /directMemos/{memoId} {
      allow read: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create, delete: if false;
      allow update: if isAuth() && (
        (
          resource.data.recipientId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRead', 'readAt', 'recipientArchivedAt', 'recipientDeletedAt', 'updatedAt'
          ])
        ) ||
        (
          resource.data.senderId == request.auth.uid &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'senderArchivedAt', 'senderDeletedAt', 'updatedAt'
            ]) ||
            (
              resource.data.isRead == false &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'senderArchivedAt', 'senderDeletedAt', 'recipientDeletedAt', 'updatedAt'
              ])
            )
          )
        )
      );
    }

    // Assignments (Stellar Archive)
    match /assignments/{assignmentId} {
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.keys().hasOnly(assignmentStudentWritableKeys());
      allow read: if isAuth();
      allow update: if isAuth() && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.status == 'submitted' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(assignmentStudentWritableKeys())
        ) ||
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(assignmentFeedbackResponseKeys()) &&
          request.resource.data.feedbackReaction in ['thumbs_up', 'thumbs_down'] &&
          request.resource.data.feedbackComment is string &&
          request.resource.data.feedbackComment.size() <= 1000 &&
          request.resource.data.feedbackResponse is map &&
          request.resource.data.feedbackResponse.reaction == request.resource.data.feedbackReaction &&
          request.resource.data.feedbackResponse.comment == request.resource.data.feedbackComment
        )
      );
      allow delete: if isAdmin();
    }

    // Assignment warning ledger. Admins issue/cancel warnings, students can only
    // submit one immutable appeal for their own active warning.
    match /assignmentWarnings/{warningId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isLinkedParentOf(resource.data.userId)
      );
      allow create: if isAdmin() || (
        isAuth() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type == 'consecutive_missing_assignment' &&
        request.resource.data.status == 'active'
      );
      allow update: if isAdmin() || (
        isAuth() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'active' &&
        (!('appealLocked' in resource.data) || resource.data.appealLocked != true) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'appeal', 'appealLocked', 'updatedAt']) &&
        request.resource.data.status == 'appealed' &&
        request.resource.data.appealLocked == true &&
        request.resource.data.appeal is map &&
        request.resource.data.appeal.status == 'submitted' &&
        request.resource.data.appeal.text is string &&
        request.resource.data.appeal.text.size() >= 10 &&
        request.resource.data.appeal.text.size() <= 2000 &&
        request.resource.data.appeal.submittedAt == request.time
      );
      allow delete: if isAdmin();
    }

    // Public assignment records shown in Stellar Agora. Creation, reactions,
    // comments, cooldowns, and rewards are handled by Cloud Functions.
    match /assignmentShares/{shareId} {
      allow read: if isAuth();
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow read: if isAuth();
        allow create, update, delete: if false;
      }
    }

    // Student-owned mistake notebook image queue. Students submit images; admins
    // turn them into flash cards after reviewing the work.
    match /mistakeUploads/{uploadId} {
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isLinkedParentOf(resource.data.userId)
      );
      allow update: if isAdmin() || (
        isAuth() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status == 'card_created' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'cardId',
          'reviewedBy',
          'reviewedAt',
          'updatedAt'
        ]) &&
        request.resource.data.cardId is string &&
        request.resource.data.cardId.size() > 0 &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt == request.time &&
        request.resource.data.updatedAt == request.time
      );
      allow delete: if isAdmin();
    }

    // Generated flash cards. Students can read their own active cards; admins
    // create and edit the back side with answer/explanation.
    match /mistakeCards/{cardId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isLinkedParentOf(resource.data.userId)
      );
      allow create: if isAdmin() || (
        isAuth() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.source in ['dark_matter_quiz', 'quiz', 'student_upload'] &&
        request.resource.data.status == 'active' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.keys().hasOnly([
          'userId',
          'userName',
          'source',
          'sourceUploadId',
          'sourceUnitId',
          'sourceQuestionId',
          'sourceQuizTitle',
          'imageUrl',
          'imagePath',
          'questionTitle',
          'questionText',
          'sourceOptions',
          'answer',
          'explanation',
          'concept',
          'tags',
          'difficulty',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.questionTitle is string &&
        request.resource.data.questionTitle.size() > 0 &&
        request.resource.data.questionTitle.size() <= 140 &&
        request.resource.data.questionText is string &&
        request.resource.data.questionText.size() <= 4000 &&
        request.resource.data.sourceOptions is list &&
        request.resource.data.sourceOptions.size() <= 12 &&
        request.resource.data.answer is string &&
        request.resource.data.answer.size() > 0 &&
        request.resource.data.answer.size() <= 1000 &&
        request.resource.data.explanation is string &&
        request.resource.data.explanation.size() > 0 &&
        request.resource.data.explanation.size() <= 8000 &&
        request.resource.data.sourceUnitId is string &&
        request.resource.data.sourceQuestionId is string &&
        request.resource.data.imageUrl is string &&
        request.resource.data.imagePath is string &&
        request.resource.data.tags is list &&
        request.resource.data.tags.size() <= 12
      );
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuth() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'explanation',
          'studentEditedAt',
          'updatedAt'
        ]) &&
        request.resource.data.explanation is string &&
        request.resource.data.explanation.size() > 0 &&
        request.resource.data.explanation.size() <= 8000 &&
        request.resource.data.studentEditedAt == request.time &&
        request.resource.data.updatedAt == request.time
      ) || (
        isAuth() &&
        resource.data.userId == request.auth.uid &&
        resource.data.source in ['dark_matter_quiz', 'quiz'] &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'sourceQuizTitle',
          'imageUrl',
          'questionTitle',
          'questionText',
          'sourceOptions',
          'answer',
          'concept',
          'tags',
          'difficulty',
          'updatedAt'
        ]) &&
        request.resource.data.questionTitle is string &&
        request.resource.data.questionTitle.size() > 0 &&
        request.resource.data.questionTitle.size() <= 140 &&
        request.resource.data.questionText is string &&
        request.resource.data.questionText.size() <= 4000 &&
        request.resource.data.sourceOptions is list &&
        request.resource.data.sourceOptions.size() <= 12 &&
        request.resource.data.answer is string &&
        request.resource.data.answer.size() > 0 &&
        request.resource.data.answer.size() <= 1000 &&
        request.resource.data.imageUrl is string &&
        request.resource.data.tags is list &&
        request.resource.data.tags.size() <= 12 &&
        request.resource.data.updatedAt == request.time
      ) || (
        isAuth() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastReviewedAt',
          'lastReviewResult'
        ]) &&
        request.resource.data.lastReviewedAt == request.time &&
        request.resource.data.lastReviewResult in ['again', 'hard', 'good', 'easy']
      ) || (
        isAuth() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'archivedBy',
          'archivedAt',
          'updatedAt'
        ]) &&
        request.resource.data.status == 'archived' &&
        request.resource.data.archivedBy == request.auth.uid &&
        request.resource.data.archivedAt == request.time &&
        request.resource.data.updatedAt == request.time
      );
    }

    // Star Messages (Community Ticker)
    match /starMessages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
    }

    // Attendance (Warp Gate Docking)
    match /attendance/{attendanceId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Collection Group: history (for Region/Chapter leaderboards)
    // Allows authenticated users to query quiz history across all users
    // for scope-specific ranking (e.g. all scores within a Region or Chapter).
    // History docs only contain quiz metadata: unitId, regionId, chapterId, score.
    match /{path=**}/history/{historyId} {
      allow read: if isAuth();
    }
  }
}

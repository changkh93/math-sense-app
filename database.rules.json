{
  "rules": {
    ".read": false,
    ".write": false,
    "userPresence": {
      ".read": "auth != null",
      "$uid": {
        "lastSeenMs": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        },
        "connections": {
          "$connectionId": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'state', 'currentLocation', 'updatedAtMs', 'enteredAtMs']) && newData.child('uid').val() === $uid && newData.child('state').val().matches(/^(online|away)$/) && newData.child('currentLocation').isString() && newData.child('currentLocation').val().length <= 120 && newData.child('updatedAtMs').isNumber() && newData.child('enteredAtMs').isNumber())"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "quizBattlePresence": {
      "$clusterId": {
        "$regionId": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "connections": {
              "$connectionId": {
                ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'displayName', 'phase', 'updatedAtMs']) && newData.child('uid').val() === $uid && newData.child('displayName').isString() && newData.child('displayName').val().length <= 40 && newData.child('phase').isString() && newData.child('phase').val().matches(/^(idle|waiting|active|result)$/) && newData.child('updatedAtMs').isNumber())"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}

    "test:elementary-math-answer": "node scripts/test-elementary-math-answer.mjs",
    "test:galaxy-terrain": "node scripts/test-galaxy-walk-surfaces.mjs",
    "test:galaxy-navigation": "node scripts/test-galaxy-navigation-safety.mjs",

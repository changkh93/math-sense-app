    "video:still:docu": "remotion still video/index.jsx MetasenseDocuBrandFilm out/metasense-docu-brand-film-still.png --frame=2250",
    "video:render:source-promo": "remotion render video/index.jsx MetasenseSourceBrandFilm out/metasense-source-brand-film.mp4 --codec=h264 --pixel-format=yuv420p",

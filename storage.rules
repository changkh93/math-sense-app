rules_version = '2';

// Craft rules based on your app's needs.
// For more information, visit https://firebase.google.com/docs/storage/security

service firebase.storage {
  match /b/{bucket}/o {
    // Quiz images are readable by everyone, but writable only by admins
    match /quiz_images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; 
    }

    // Drawings/Uploads for questions
    match /drawings/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Extension uploads
    match /agora-connect/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Mission images
    match /mission_images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; 
    }

    // Assignment file uploads (Stellar Archive)
    match /assignments/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

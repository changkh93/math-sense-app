rules_version = '2';

// Craft rules based on your app's needs.
// For more information, visit https://firebase.google.com/docs/storage/security

service firebase.storage {
  match /b/{bucket}/o {
    function isMemberAuth() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return isMemberAuth() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Quiz images are readable by everyone, but writable only by admins
    match /quiz_images/{allPaths=**} {
      allow read: if true;
      allow write: if isMemberAuth();
    }

    // Drawings/Uploads for questions
    match /drawings/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isMemberAuth() && request.auth.uid == userId;
    }

    // Extension uploads
    match /agora-connect/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isMemberAuth() && request.auth.uid == userId;
    }

    // Mission images
    match /mission_images/{allPaths=**} {
      allow read: if true;
      allow write: if isMemberAuth();
    }

    // Published workbook pages are public learning assets, but only operators may upload them.
    match /workbook_images/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }

    // Assignment file uploads (Stellar Archive)
    match /assignments/{userId}/{allPaths=**} {
      allow read: if isMemberAuth();
      allow write: if isMemberAuth() && request.auth.uid == userId;
    }

    // Student mistake notebook images
    match /mistake-notes/{userId}/{allPaths=**} {
      allow read: if isMemberAuth();
      allow write: if isMemberAuth() && request.auth.uid == userId;
    }

    // Owner-managed reference images for objects placed in a Galaxy world.
    // Other signed-in members can only read them while viewing an accessible planet.
    match /galaxy-objects/{userId}/{instanceId}/{fileName} {
      allow read: if isMemberAuth();
      allow create, update: if isMemberAuth() &&
        request.auth.uid == userId &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isMemberAuth() && request.auth.uid == userId;
    }
  }
}

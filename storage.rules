rules_version = '2';

// Craft rules based on your app's needs.
// For more information, visit https://firebase.google.com/docs/storage/security

service firebase.storage {
  match /b/{bucket}/o {
    function isMemberAuth() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Quiz images are readable by everyone, but writable only by admins
    match /quiz_images/{allPaths=**} {
      allow read: if true;
      allow write: if isMemberAuth();
    }

    // Drawings/Uploads for questions
    match /drawings/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isMemberAuth() && request.auth.uid == userId;
    }

    // Extension uploads
    match /agora-connect/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isMemberAuth() && request.auth.uid == userId;
    }

    // Mission images
    match /mission_images/{allPaths=**} {
      allow read: if true;
      allow write: if isMemberAuth();
    }

    // Assignment file uploads (Stellar Archive)
    match /assignments/{userId}/{allPaths=**} {
      allow read: if isMemberAuth();
      allow write: if isMemberAuth() && request.auth.uid == userId;
    }

    // Student mistake notebook images
    match /mistake-notes/{userId}/{allPaths=**} {
      allow read: if isMemberAuth();
      allow write: if isMemberAuth() && request.auth.uid == userId;
    }
  }
}
